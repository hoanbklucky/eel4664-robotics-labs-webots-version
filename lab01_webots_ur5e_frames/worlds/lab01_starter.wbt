}
Solid {
  translation 0 0 -0.025
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.38 0.42
        roughness 0.8
      }
      geometry Box {
        size 3 3 0.05
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 3 3 0.05
  }
}
DEF UR5E UR5e {
  controller "void"
  toolSlot [
    # Visual-only stylus aligned with the Universal Robots tool-slot +y axis.
    # No boundingObject or Physics node: it cannot alter the robot dynamics.
    Pose {
      translation 0 0.0125 0
      rotation 1 0 0 -1.57079632679
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.18 0.20 0.24
            metalness 0.7
            roughness 0.28
          }
          geometry Cylinder {
            height 0.025
            radius 0.022
            subdivision 24
          }
        }
      ]
    }
    Pose {
      translation 0 0.065 0
      rotation 1 0 0 -1.57079632679
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.04 0.24 0.62
            metalness 0.15
            roughness 0.32
          }
          geometry Cylinder {
            height 0.08
            radius 0.009
            subdivision 24
          }
        }
      ]
    }
    Pose {
      translation 0 0.1175 0
      rotation 1 0 0 -1.57079632679
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 0.18 0.02
            emissiveColor 0.25 0.025 0
            roughness 0.3
          }
          geometry Cone {
            height 0.025
            bottomRadius 0.01
            subdivision 24
          }
        }
      ]
    }
    GPS {
      name "tool_position"
    }
    InertialUnit {
      name "tool_orientation"
    }
    Pose {
      translation 0 0.13 0
