#VRML_SIM R2025a utf8
# COURSE STARTER: DO NOT OVERWRITE. Copy to *_work.wbt before opening in Webots.

EXTERNPROTO "../../webots/vendor/webots_r2025a/projects/robots/universal_robots/protos/UR5e.proto"

WorldInfo {
  title "EEL 4664 Lab 4 Jacobian clean UR5e starter"
  basicTimeStep 8
}
Viewpoint {
  # Instructor-approved view: frames the complete UR5e at startup.
  orientation -0.262 -0.418 0.87 5.15
  position -2.08 3.1 2.48
  fieldOfView 0.75
  near 0.05
}
Background {
  skyColor [
    0.65 0.72 0.82
  ]
}
DirectionalLight {
  direction -0.4 -0.5 -1
  intensity 2
  ambientIntensity 0.5
}
Solid {
  translation 0 0 -0.025
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.38 0.42
        roughness 0.8
      }
      geometry Box {
        size 3 3 0.05
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 3 3 0.05
  }
}
# Shared visual-only Cartesian reference grid.
DEF COURSE_GRID Shape {
  appearance PBRAppearance {
    baseColor 0.18 0.21 0.25
    emissiveColor 0.025 0.03 0.04
    roughness 1
  }
  geometry IndexedLineSet {
    coord Coordinate {
      point [
        -0.8 -0.8 0.003, -0.8 0.8 0.003,
        -0.4 -0.8 0.003, -0.4 0.8 0.003,
        0 -0.8 0.003, 0 0.8 0.003,
        0.4 -0.8 0.003, 0.4 0.8 0.003,
        0.8 -0.8 0.003, 0.8 0.8 0.003,
        -0.8 -0.8 0.003, 0.8 -0.8 0.003,
        -0.8 -0.4 0.003, 0.8 -0.4 0.003,
        -0.8 0 0.003, 0.8 0 0.003,
        -0.8 0.4 0.003, 0.8 0.4 0.003,
        -0.8 0.8 0.003, 0.8 0.8 0.003
      ]
    }
    coordIndex [
      0 1 -1, 2 3 -1, 4 5 -1, 6 7 -1, 8 9 -1,
      10 11 -1, 12 13 -1, 14 15 -1, 16 17 -1, 18 19 -1
    ]
  }
}
DEF WORLD_FRAME_REFERENCE Group {
  children [
    Pose {
      translation 0.12 0 0.012
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.9 0.08 0.08 emissiveColor 0.12 0 0 }
          geometry Box { size 0.24 0.008 0.008 }
        }
      ]
    }
    Pose {
      translation 0 0.12 0.012
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.08 0.8 0.12 emissiveColor 0 0.1 0 }
          geometry Box { size 0.008 0.24 0.008 }
        }
      ]
    }
    Pose {
      translation 0 0 0.12
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.08 0.25 0.95 emissiveColor 0 0.02 0.15 }
          geometry Box { size 0.008 0.008 0.24 }
        }
      ]
    }
  ]
}# Visual-only local Cartesian direction reference for Jacobian experiments.
DEF CARTESIAN_DIRECTION_REFERENCE Pose {
  translation 0.62 0.18 0.34
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.95 0.95 0.95 transparency 0.35 roughness 0.8 }
      geometry Sphere { radius 0.028 subdivision 2 }
    }
    Pose {
      translation 0.10 0 0
      children [ Shape { appearance PBRAppearance { baseColor 0.95 0.08 0.08 emissiveColor 0.12 0 0 } geometry Box { size 0.20 0.009 0.009 } } ]
    }
    Pose {
      translation 0 0.10 0
      children [ Shape { appearance PBRAppearance { baseColor 0.08 0.85 0.12 emissiveColor 0 0.12 0 } geometry Box { size 0.009 0.20 0.009 } } ]
    }
    Pose {
      translation 0 0 0.10
      children [ Shape { appearance PBRAppearance { baseColor 0.08 0.25 0.95 emissiveColor 0 0.02 0.15 } geometry Box { size 0.009 0.009 0.20 } } ]
    }
  ]
}
# Dynamic overlays controlled by singularity_demo. Yellow shows the requested
# Cartesian path; red shows the translation the tool actually completes.
DEF REQUEST_START_MARKER Pose {
  translation 0 0 -1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.1 0.85 1 emissiveColor 0.02 0.2 0.25 }
      geometry Sphere { radius 0.014 subdivision 2 }
    }
  ]
}
DEF REQUEST_GOAL_MARKER Pose {
  translation 0 0 -1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.15 1 0.2 emissiveColor 0.05 0.35 0.06 }
      geometry Sphere { radius 0.022 subdivision 2 }
    }
  ]
}
DEF REQUEST_DOT_1 Pose {
  translation 0 0 -1
  children [ Shape { appearance PBRAppearance { baseColor 1 0.9 0.05 emissiveColor 0.3 0.22 0 } geometry Sphere { radius 0.012 subdivision 2 } } ]
}
DEF REQUEST_DOT_2 Pose {
  translation 0 0 -1
  children [ Shape { appearance PBRAppearance { baseColor 1 0.9 0.05 emissiveColor 0.3 0.22 0 } geometry Sphere { radius 0.012 subdivision 2 } } ]
}
DEF REQUEST_DOT_3 Pose {
  translation 0 0 -1
  children [ Shape { appearance PBRAppearance { baseColor 1 0.9 0.05 emissiveColor 0.3 0.22 0 } geometry Sphere { radius 0.012 subdivision 2 } } ]
}
DEF REQUEST_DOT_4 Pose {
  translation 0 0 -1
  children [ Shape { appearance PBRAppearance { baseColor 1 0.9 0.05 emissiveColor 0.3 0.22 0 } geometry Sphere { radius 0.012 subdivision 2 } } ]
}
DEF REQUESTED_PATH Shape {
  appearance PBRAppearance { baseColor 1 0.9 0.05 emissiveColor 0.35 0.28 0 }
  geometry IndexedLineSet {
    coord DEF REQUESTED_PATH_COORD Coordinate { point [ 0 0 -1, 0 0 -1 ] }
    coordIndex [ 0 1 -1 ]
  }
}
DEF ACTUAL_END_MARKER Pose {
  translation 0 0 -1
  children [
    Shape {
      appearance PBRAppearance { baseColor 1 0.08 0.08 emissiveColor 0.35 0.01 0.01 }
      geometry Sphere { radius 0.018 subdivision 2 }
    }
  ]
}
DEF ACTUAL_PATH Shape {
  appearance PBRAppearance { baseColor 1 0.08 0.08 emissiveColor 0.4 0.01 0.01 }
  geometry IndexedLineSet {
    coord DEF ACTUAL_PATH_COORD Coordinate { point [ 0 0 -1, 0 0 -1 ] }
    coordIndex [ 0 1 -1 ]
  }
}
DEF UR5E UR5e {
  # Start directly at the bent-elbow Trial 1 configuration.
  hidden position_0_0 0.2
  hidden rotation_1 0 0 1 0.2
  hidden position_1_0 -0.8
  hidden rotation_2 0 1 0 0.77079632679
  hidden position_2_0 1.4
  hidden rotation_3 0 1 0 1.4
  hidden position_3_0 -1.1
  hidden rotation_4 0 1 0 0.47079632679
  hidden position_4_0 -0.7
  hidden rotation_5 0 0 -1 0.7
  hidden position_5_0 0.3
  hidden rotation_6 0 1 0 0.3
  controller "singularity_demo"
  supervisor TRUE
  toolSlot [
    # Visual-only stylus aligned with the Universal Robots tool-slot +y axis.
    # No boundingObject or Physics node: it cannot alter the robot dynamics.
    Pose {
      translation 0 0.0125 0
      rotation 1 0 0 -1.57079632679
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.18 0.20 0.24
            metalness 0.7
            roughness 0.28
          }
          geometry Cylinder {
            height 0.025
            radius 0.022
            subdivision 24
          }
        }
      ]
    }
    Pose {
      translation 0 0.065 0
      rotation 1 0 0 -1.57079632679
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.04 0.24 0.62
            metalness 0.15
            roughness 0.32
          }
          geometry Cylinder {
            height 0.08
            radius 0.009
            subdivision 24
          }
        }
      ]
    }
    Pose {
      translation 0 0.1175 0
      rotation 1 0 0 -1.57079632679
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 0.18 0.02
            emissiveColor 0.25 0.025 0
            roughness 0.3
          }
          geometry Cone {
            height 0.025
            bottomRadius 0.01
            subdivision 24
          }
        }
      ]
    }
    GPS {
      name "tool_position"
    }
    InertialUnit {
      name "tool_orientation"
    }
    Pose {
      translation 0 0.13 0
      children [
        GPS {
          name "tool_test_point_position"
        }
      ]
    }
  ]
}
